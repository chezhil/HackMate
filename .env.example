# Copy to .env.local and fill in to send real reminder emails.
# Without SMTP_HOST, reminders are only written to the outbox on the Settings page.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
# For Gmail, create an app password: https://myaccount.google.com/apppasswords
SMTP_PASS=
SMTP_FROM="HackMate <you@gmail.com>"

# Public URL of the app. Google/Outlook calendar subscriptions need a URL they can reach
# (not localhost). Leave unset when running locally.
# NEXT_PUBLIC_BASE_URL=https://hackmate.example.com
