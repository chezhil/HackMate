  "font": {
    "sans": "var(--font-display), system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "mono": "var(--font-geist-mono), ui-monospace, SFMono-Regular, Menlo, monospace",
    "_note": "Space Grotesk (SIL OFL) for all UI text, Geist Mono (SIL OFL) for code; both loaded by next/font in layout.tsx."
  },
  "type": {
    "2xs": {
      "size": 11,
      "line": 14,
      "weight": 500,
      "use": "calendar chips, keyboard hints (replaces text-[10px])"
    },
    "xs": {
      "size": 12,
      "line": 16,
      "weight": 400,
      "use": "meta, chips, badges, labels"
    },
    "sm": {
      "size": 14,
      "line": 20,
      "weight": 400,
      "use": "body and controls (the default)"
    },
    "base": {
      "size": 16,
      "line": 24,
      "weight": 400,
      "use": "long-form AI output"
    },
    "lg": {
      "size": 18,
      "line": 28,
      "weight": 600,
      "use": "card titles, dialog titles"
    },
    "xl": {
      "size": 20,
      "line": 28,
      "weight": 600,
      "use": "empty-state titles"
    },
    "2xl": {
      "size": 24,
      "line": 32,
      "weight": 600,
      "use": "page titles (tracking-tight)"
    },
    "3xl": {
      "size": 30,
      "line": 36,
      "weight": 600,
      "use": "stat numbers (tabular-nums)"
    }
  },
  "space": [
    0,
    2,
    4,
    6,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 10,
    "pill": 999,
    "_map": "Tailwind's rounded-md/lg/xl/2xl are remapped to these, so existing classes get the tighter brutalist corners. sm badges · md controls · lg cards · xl dialogs · pill chips"
  },
  "shadow": {
    "hard-sm": "2px 2px 0 0 var(--ink-shadow)",
    "hard": "4px 4px 0 0 var(--ink-shadow)",
    "pop": "6px 6px 0 0 var(--ink-shadow)",
    "_note": "No blur anywhere. Cards sit on hard; buttons on hard-sm and drop into it when pressed; floating layers use pop. Shadows use ink-shadow: ink in light mode, near-black in dark mode so they don't glow."
  },
  "overlay": {
    "scrim": "rgba(17,17,17,.55)",
    "scrim-dark": "rgba(0,0,0,.7)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "_note": "Respect prefers-reduced-motion: no movement, fades only."
  },
  "focus": {
    "width": 2,
    "offset": 2,
    "_note": "outline 2px var(--focus), offset 2px, on :focus-visible only."
  },
  "layout": {
    "content-max": 1280,
    "gutter": 16,
    "header": 56,
    "side-panel": 352,
    "breakpoints": {
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280
    }
  },
  "z": {
    "map": 0,
    "_map-note": "Leaflet uses 400-1000 inside its container",
    "sticky": 1000,
    "drawer": 1100,
    "dialog": 1200,
    "toast": 1300
  },
  "_style": "Neobrutalist: ink outlines (border = text colour), hard offset shadows with no blur, flat loud fills, small radii, cream dotted-grid page, chunky grotesque type. Buttons press into their shadow on click.",
  "border-width": {
    "line": 2,
    "_note": "Cards, controls, badges and chips all use a 2px ink outline."
  },
  "map": {
    "tile-filter": "grayscale(1) sepia(0.3) brightness(1.06) contrast(0.92)",
    "tile-filter-dark": "invert(1) hue-rotate(180deg) grayscale(0.9) brightness(0.78) contrast(0.95)",
    "_note": "OpenStreetMap tiles are recoloured with a CSS filter so the map sits in the theme without another tile provider. Pins are outlined in ink, so their fills only need to be loud, not high-contrast."
  }
}
