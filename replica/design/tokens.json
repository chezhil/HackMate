  "font": {
    "sans": "var(--font-geist-sans), system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "mono": "var(--font-geist-mono), ui-monospace, SFMono-Regular, Menlo, monospace",
    "_note": "Geist (SIL OFL), loaded by next/font in layout.tsx."
  },
  "type": {
    "2xs": {
      "size": 11,
      "line": 14,
      "weight": 500,
      "use": "calendar chips, keyboard hints (replaces text-[10px])"
    },
    "xs": {
      "size": 12,
      "line": 16,
      "weight": 400,
      "use": "meta, chips, badges, labels"
    },
    "sm": {
      "size": 14,
      "line": 20,
      "weight": 400,
      "use": "body and controls (the default)"
    },
    "base": {
      "size": 16,
      "line": 24,
      "weight": 400,
      "use": "long-form AI output"
    },
    "lg": {
      "size": 18,
      "line": 28,
      "weight": 600,
      "use": "card titles, dialog titles"
    },
    "xl": {
      "size": 20,
      "line": 28,
      "weight": 600,
      "use": "empty-state titles"
    },
    "2xl": {
      "size": 24,
      "line": 32,
      "weight": 600,
      "use": "page titles (tracking-tight)"
    },
    "3xl": {
      "size": 30,
      "line": 36,
      "weight": 600,
      "use": "stat numbers (tabular-nums)"
    }
  },
  "space": [
    0,
    2,
    4,
    6,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "pill": 999,
    "_map": "sm = badges, kbd, calendar chips (rounded-md) \u00b7 md = buttons, inputs, menus (rounded-lg) \u00b7 lg = cards, panels (rounded-xl) \u00b7 xl = dialogs, drawers (rounded-2xl) \u00b7 pill = chips, count pills (rounded-full)"
  },
  "shadow": {
    "none": "none",
    "pop": "0 8px 24px rgba(16,16,12,.12), 0 2px 6px rgba(16,16,12,.08)",
    "pop-dark": "0 8px 24px rgba(0,0,0,.5), 0 2px 6px rgba(0,0,0,.4)",
    "_note": "Cards are flat (border, no shadow). Only floating layers (menus, dialogs, toasts, map popups) get pop."
  },
  "overlay": {
    "scrim": "rgba(16,16,12,.45)",
    "scrim-dark": "rgba(0,0,0,.6)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "_note": "Respect prefers-reduced-motion: no movement, fades only."
  },
  "focus": {
    "width": 2,
    "offset": 2,
    "_note": "outline 2px var(--focus), offset 2px, on :focus-visible only."
  },
  "layout": {
    "content-max": 1280,
    "gutter": 16,
    "header": 56,
    "side-panel": [
      320,
      380
    ],
    "breakpoints": {
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280
    }
  },
  "z": {
    "map": 0,
    "_map-note": "Leaflet uses 400-1000 inside its container",
    "sticky": 1000,
    "drawer": 1100,
    "dialog": 1200,
    "toast": 1300
  }
}